map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 8080;
  location = /__n8nmeter/healthz {
    access_log off;
    return 200 'ok';
  }
  location ~ ^/__n8nmeter/(workflow-bridge|workflow-usage|overlay)\.js$ {
    alias /overlay/$1.js;
    default_type application/javascript;
    add_header Cache-Control no-store;
  }
  location = /__n8nmeter/api/summary {
    proxy_pass ${N8N_METER_UPSTREAM}/api/summary;
    proxy_set_header Cookie $http_cookie;
  }
  location /__n8nmeter/ { return 404; }
  location / {
    proxy_pass ${N8N_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Accept-Encoding "";
    proxy_buffering off;
    sub_filter_once on;
    sub_filter '</body>' '<script src="/__n8nmeter/workflow-bridge.js" defer></script><script src="/__n8nmeter/workflow-usage.js" defer></script><script src="/__n8nmeter/overlay.js" defer></script></body>';
  }
}
